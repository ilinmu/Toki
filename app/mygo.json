{
  "name": "Toki",
  "slug": "toki",
  "identifier": "dev.linmu.toki",
  "version": "0.1.4",
  "copyright": "Copyright © 2026 linmu",
  "publisher": "linmu",
  "license": "MIT",
  "out": "build",
  "fileAssociations": [
    {
      "ext": ["jpg", "jpeg", "jpe", "jfif"],
      "name": "JPEG Image",
      "mimeType": "image/jpeg",
      "role": "Viewer"
    },
    {
      "ext": ["png"],
      "name": "PNG Image",
      "mimeType": "image/png",
      "role": "Viewer"
    },
    {
      "ext": ["gif"],
      "name": "GIF Image",
      "mimeType": "image/gif",
      "role": "Viewer"
    },
    {
      "ext": ["bmp"],
      "name": "BMP Image",
      "mimeType": "image/bmp",
      "role": "Viewer"
    },
    {
      "ext": ["webp"],
      "name": "WebP Image",
      "mimeType": "image/webp",
      "role": "Viewer"
    },
    {
      "ext": ["tif", "tiff"],
      "name": "TIFF Image",
      "mimeType": "image/tiff",
      "role": "Viewer"
    }
  ],
  "macos": {
    "infoPlist": {
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "JPEG Image",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.jpeg"],
          "CFBundleTypeExtensions": ["jpg", "jpeg", "jpe", "jfif"],
          "CFBundleTypeMIMETypes": ["image/jpeg"]
        },
        {
          "CFBundleTypeName": "PNG Image",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.png"],
          "CFBundleTypeExtensions": ["png"],
          "CFBundleTypeMIMETypes": ["image/png"]
        },
        {
          "CFBundleTypeName": "GIF Image",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["com.compuserve.gif"],
          "CFBundleTypeExtensions": ["gif"],
          "CFBundleTypeMIMETypes": ["image/gif"]
        },
        {
          "CFBundleTypeName": "BMP Image",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["com.microsoft.bmp"],
          "CFBundleTypeExtensions": ["bmp"],
          "CFBundleTypeMIMETypes": ["image/bmp"]
        },
        {
          "CFBundleTypeName": "WebP Image",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["org.webmproject.webp"],
          "CFBundleTypeExtensions": ["webp"],
          "CFBundleTypeMIMETypes": ["image/webp"]
        },
        {
          "CFBundleTypeName": "TIFF Image",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.tiff"],
          "CFBundleTypeExtensions": ["tif", "tiff"],
          "CFBundleTypeMIMETypes": ["image/tiff"]
        }
      ]
    }
  }
}
